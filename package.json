{
  "name": "career-ops",
  "version": "1.25.0",
  "description": "AI-powered job search pipeline — works with any AI coding CLI (Claude Code, Codex, OpenCode, Antigravity, Grok, Qwen, Kimi, Copilot)",
  "private": true,
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "doctor": "bun doctor.mjs",
    "or": "bun openrouter-runner.mjs",
    "or:scan": "bun openrouter-runner.mjs scan",
    "or:pipeline": "bun openrouter-runner.mjs pipeline",
    "or:eval": "bun openrouter-runner.mjs evaluate",
    "or:apply": "bun openrouter-runner.mjs apply",
    "verify": "bun verify-pipeline.mjs",
    "normalize": "bun normalize-statuses.mjs",
    "dedup": "bun dedup-tracker.mjs",
    "merge": "bun merge-tracker.mjs",
    "reconcile": "bun reconcile-pipeline.mjs",
    "pdf": "bun generate-pdf.mjs",
    "jd:similarity": "bun jd-similarity.mjs",
    "img-to-pdf": "bun img-to-pdf.mjs",
    "cover-letter": "bun generate-cover-letter.mjs --payload",
    "cv:verify-facts": "bun verify-cv-facts.mjs",
    "test:cv-visual": "playwright test --config=playwright.cv.config.mjs",
    "test:cv-visual:update": "playwright test --config=playwright.cv.config.mjs --update-snapshots",
    "sync-check": "bun cv-sync-check.mjs",
    "update:check": "bun update-system.mjs check",
    "update:test": "bun updater-migration-tests.mjs",
    "update": "bun update-system.mjs apply",
    "rollback": "bun update-system.mjs rollback",
    "liveness": "bun check-liveness.mjs",
    "extract": "bun browser-extract.mjs",
    "scan": "bun scan.mjs",
    "scan:full": "bun scan-ats-full.mjs",
    "scan:seeds": "bun scan-ats-full.mjs --seeds yc,a16z",
    "scan:yc": "bun scan-ats-full.mjs --seeds yc",
    "scan:interamt": "bun scan-interamt.mjs",
    "company:funded": "bun company-funded.mjs",
    "validate:portals": "bun validate-portals.mjs",
    "verify:portals": "bun verify-portals.mjs",
    "tracker": "bun tracker.mjs",
    "find": "bun find.mjs",
    "patterns": "bun analyze-patterns.mjs",
    "upskill": "bun upskill.mjs",
    "add": "bun add-entry.mjs",
    "reposts": "bun detect-reposts.mjs",
    "digest": "bun weekly-digest.mjs",
    "freshness": "bun check-table-freshness.mjs",
    "invite-match": "bun invite-match.mjs",
    "paste-reply": "bun paste-reply.mjs",
    "gemini:eval": "bun gemini-eval.mjs",
    "ollama:eval": "bun ollama-eval.mjs",
    "openai:eval": "bun openai-eval.mjs",
    "openai:tailor": "bun openai-tailor.mjs",
    "eval:golden": "bun eval-golden.mjs",
    "star": "bun match-star.mjs",
    "archive": "bun archive-posting.mjs",
    "prepare:application": "bun prepare-application.mjs",
    "application:init": "bun application-artifacts.mjs --init",
    "build:dashboard": "bun build-dashboard.mjs",
    "serve:dashboard": "cd dashboard && go run . --path ..",
    "postinstall": "bunx playwright install chromium --with-deps || bunx playwright install chromium --with-deps",
    "manifesto": "bun manifesto.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "career-ops",
    "careerops",
    "automation",
    "codex",
    "antigravity",
    "qwen",
    "kimi",
    "copilot",
    "grok",
    "ai-agent-skill"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.0.0",
    "js-yaml": "^4.1.1",
    "playwright": "1.62.1"
  }
}
